# One ARM64 image for everything, built by CodeBuild (never locally):
#   * AgentCore Runtimes (pipeline, assistant) run the image's default command: the AgentCore HTTP server on :8080
#   * the API Lambda overrides entrypoint/command with the Lambda runtime interface client (awslambdaric)
# AgentCore requires ARM64 and an image of at most 2 GB, so Docling/PyTorch are left out and the reranker is the 0.15 GB one.
FROM --platform=linux/arm64 python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/app
WORKDIR /app

# dependencies first (cached layer); requirements-lambda.txt is generated by scripts/aws_bundle.py and leaves out Docling/torch
COPY requirements-lambda.txt /app/
RUN pip install -r requirements-lambda.txt awslambdaric \
 # the desktop OpenCV needs libxcb/GL, which these images do not have: use the headless build with the same version
 && V=$(pip show opencv-python | sed -n 's/^Version: //p') && pip uninstall -y opencv-python \
 && pip install "opencv-python-headless==$V" \
 && find /usr/local/lib/python3.12 -depth -type d -name tests -prune -exec rm -rf {} + \
 && find /usr/local/lib/python3.12 -name "*.pyc" -delete

COPY backend/src/medishield /app/medishield
COPY data/official/records /app/data/records
COPY data/official/dataset/policies /app/data/dataset/policies
COPY docs/eval_results /app/eval_results

# OCR models are downloaded on first use into site-packages, which is read-only at run time: fetch both recognisers now
RUN python -c "from medishield.ocr.engine import _engine; _engine('default'); _engine('devanagari')"

# embedding / reranking models are fetched at build time so a cold start never downloads anything
ENV MEDISHIELD_CACHE=/opt/baked
RUN python - <<'PY'
from fastembed import SparseTextEmbedding, TextEmbedding
from fastembed.rerank.cross_encoder import TextCrossEncoder
import os
cache = os.path.join(os.environ["MEDISHIELD_CACHE"], "fastembed")
TextEmbedding("BAAI/bge-small-en-v1.5", cache_dir=cache)
SparseTextEmbedding("Qdrant/bm25", cache_dir=cache)
TextCrossEncoder("jinaai/jina-reranker-v1-turbo-en", cache_dir=cache)
PY
COPY policy_index_cache/ /opt/baked/policy_index/

# the build bundle is made on a laptop with owner-only file modes; the runtime user must be able to read everything
RUN chmod -R a+rX /app /opt/baked

# fail the build, not the first request, if anything the handlers import is missing or the policy store cannot be built
# (a throwaway local database: the build has no AWS credentials; the functions use DynamoDB via their roles)
RUN MEDISHIELD_DB=sql MEDISHIELD_STATE_DIR=/tmp/selfcheck MEDISHIELD_CACHE=/opt/baked MEDISHIELD_DATA=/app/data \
    python -c "import medishield.aws_handlers, medishield.agentcore_app, medishield.api.main, medishield.graph.build; from medishield.rag.retrieve import get_store; get_store(); print('image self-check ok')" \
 && rm -rf /tmp/selfcheck

# run-time settings (secrets come from SSM at cold start)
ENV BAKED_CACHE=/opt/baked MEDISHIELD_CACHE=/tmp/cache MEDISHIELD_STATE_DIR=/tmp/state MEDISHIELD_DATA=/app/data \
    MEDISHIELD_EVAL_DIR=/app/eval_results MEDISHIELD_ENV=production MEDISHIELD_DB=dynamodb STORAGE_BACKEND=s3 \
    MEDISHIELD_QUEUE=agentcore MEDISHIELD_LLM_CACHE=0 HF_HOME=/tmp/hf DOCKER_CONTAINER=1
EXPOSE 8080
CMD ["python", "-m", "medishield.agentcore_app"]
