# Copy to .env (git-ignored) and fill in. Nothing here is a real secret.

# --- Models -------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
MEDISHIELD_BUDGET_USD=15            # hard cap on cumulative recorded spend; calls stop when reached
MEDISHIELD_DAILY_BUDGET_USD=0       # per-day cap for public demos (0 = unlimited)
# MEDISHIELD_MODEL_POLICY=claude-opus-5-5     # override any step: CLASSIFIER, EXTRACT, KYC_VISUAL, POLICY, FRAUD, JUSTIFY
# MEDISHIELD_LLM_OFFLINE=1          # replay cached responses only; a cache miss fails instead of spending

# --- API ----------------------------------------------------------------------------------------
MEDISHIELD_ENV=dev                  # "production" refuses to start with the default JWT secret
JWT_SECRET=                         # required in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:3000
MEDISHIELD_DEMO_USERS=1             # seeds submitter/reviewer/senior/auditor/admin (password: <name>-demo); off in production
# ADMIN_USERNAME=admin              # production: create the admin from the environment instead
# ADMIN_PASSWORD=
UPLOAD_RATE_PER_MIN=10
LOGIN_RATE_PER_MIN=10
MAX_UPLOAD_BYTES=10485760
FOUR_EYES_AMOUNT=10000              # overrides above this claimed amount need a second senior approver
SLA_HOURS=24

# --- Storage / database / queue (all optional; local defaults work out of the box) --------------
# DATABASE_URL=postgresql+psycopg://user:pass@host/db     # default: SQLite under MEDISHIELD_STATE_DIR
# STORAGE_BACKEND=s3                                     # S3-compatible: AWS, Supabase, R2, MinIO
# S3_BUCKET=
# S3_ENDPOINT_URL=
# REDIS_URL=                                             # default queue: SQLite-backed Huey
# MEDISHIELD_STATE_DIR=~/.cache/medishield/state

# --- Email intake (optional; docs/aws.md "Email intake") ----------------------------------------
# INTAKE_SENDERS='{"scanner@clinic.example": "submitter"}'  # only these senders' mail becomes a case; empty = none
# INTAKE_MIN_INLINE_IMAGE_BYTES=20480                         # smaller inline images are logos / signatures
# INBOUND_EMAIL_DOMAIN=claims.example.com                     # aws_deploy.sh: SES receives mail for intake@<domain>
